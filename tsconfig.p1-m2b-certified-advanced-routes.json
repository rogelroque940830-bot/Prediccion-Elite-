{
  "include": [
    "server/mlb-p1-advanced-component-certification-routes.ts",
    "server/mlb-p1-advanced-component-certification-routes.test.ts",
    "server/mlb-discipline-speed.ts",
    "server/mlb-sos.ts",
    "shared/**/*"
  ],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "module": "ESNext",
    "strict": false,
    "lib": ["esnext", "dom"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./shared/*"]
    },
    "outDir": "dist",
    "noEmit": true
  }
}
