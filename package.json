{
  "name": "courtedge-backend",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build:backend": "esbuild server/staging-entry.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.cjs --external:better-sqlite3 --external:bufferutil",
    "start": "node dist/index.cjs",
    "dev": "tsx server/staging-entry.ts",
    "typecheck:mlb-ledger": "tsc -p tsconfig.mlb-ledger.json",
    "test:mlb-ledger": "tsx --test server/mlb-ledger.test.ts server/mlb-settlement-worker.test.ts server/mlb-scientific-snapshot.test.ts server/mlb-injury-identity.test.ts server/mlb-pitcher-vs-team.test.ts server/mlb-injury-shadow.test.ts server/mlb-injury-phase-b.test.ts server/mlb-injury-phase-b-frontend.test.ts server/mlb-injury-audit.test.ts server/mlb-injury-calibration-report.test.ts server/mlb-injury-calibration-captured-at-dedupe.test.ts",
    "test:mlb-injuries": "tsx --test server/mlb-injury-identity.test.ts server/mlb-injury-shadow.test.ts server/mlb-injury-phase-b.test.ts server/mlb-injury-phase-b-frontend.test.ts server/mlb-injury-audit.test.ts server/mlb-injury-calibration-report.test.ts server/mlb-injury-calibration-captured-at-dedupe.test.ts",
    "test:mlb-pitcher-history": "tsx --test server/mlb-pitcher-vs-team.test.ts",
    "test:mlb-injury-shadow": "tsx --test server/mlb-injury-shadow.test.ts server/mlb-injury-phase-b.test.ts server/mlb-injury-phase-b-frontend.test.ts server/mlb-injury-audit.test.ts server/mlb-injury-calibration-report.test.ts server/mlb-injury-calibration-captured-at-dedupe.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.39.3",
    "esbuild": "^0.25.0",
    "express": "^5.0.1",
    "express-session": "^1.18.1",
    "memorystore": "^1.6.7",
    "passport": "^0.7.0",
    "passport-local": "^0.7.0",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "20.19.27",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/ws": "^8.5.13"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}
