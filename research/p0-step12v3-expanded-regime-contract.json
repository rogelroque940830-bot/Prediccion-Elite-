{
  "schemaVersion": "courtedge-p0-step12v3-expanded-regime-contract.v1",
  "objective": "Test whether new pregame variable families improve full-game home moneyline discrimination beyond the Step 12V 44-feature baseline without same-date or future leakage.",
  "dataBoundary": {
    "trainingSeason": 2022,
    "thresholdSelectionSeason": 2023,
    "replicationSeasons": [2024, 2025, "2026_YTD"],
    "sameDateOutcomeMayTrainSameDate": false,
    "futureSeasonStatsMayBackfillEarlierGames": false,
    "outcomeRole": "LABEL_ONLY_AFTER_PREDICTION"
  },
  "newFeatureFamilies": [
    "STARTER_LAST_1_3_5",
    "STARTER_REST",
    "TEAM_LAST_3_5",
    "VENUE_SPLITS_LAST_3_5",
    "BULLPEN_OUTS_PROXY_1_2_3D"
  ],
  "model": {
