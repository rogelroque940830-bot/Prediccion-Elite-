        "last_name, first_name": "name",
        "pa": "pa",
        "era": "era",
        "xera": "xera",
        "era_minus_xera_diff": "eraMinusXeraDiff",
        "woba": "wOBA",
        "est_woba": "xwOBA",
        "est_woba_minus_woba_diff": "xwobaMinusWobaDiff"
      }
    },
    "pitcherQuality": {
      "authority": "BASEBALL_SAVANT_STATCAST",
      "urlTemplate": "https://baseballsavant.mlb.com/leaderboard/statcast?type=pitcher&year=${yr}&min=q&csv=true",
      "yearBinding": "SYSTEM_NEW_DATE_CURRENT_YEAR",
      "qualificationParameter": "min=q",
      "fields": {
        "player_id": "playerId",
        "ev95percent": "hardHitPct",
        "brl_percent": "barrelPct"
      }
    },
    "expectedBatters": {
      "authority": "BASEBALL_SAVANT_EXPECTED_STATISTICS",
      "urlTemplate": "https://baseballsavant.mlb.com/leaderboard/expected_statistics?type=batter&year=${yr}&min=q&csv=true",
      "yearBinding": "SYSTEM_NEW_DATE_CURRENT_YEAR",
      "qualificationParameter": "min=q",
      "fields": {
        "player_id": "playerId",
        "last_name, first_name": "name",
        "pa": "pa",
        "woba": "wOBA",
        "est_woba": "xwOBA"
      }
    },
    "wholeSourceEmptyBehavior": {
      "expectedPitchers": "FAIL_CLOSED_STATCAST_QUALITY_EXPECTED_PITCHERS_EMPTY",
      "pitcherQuality": "FAIL_CLOSED_STATCAST_QUALITY_PITCHER_QUALITY_EMPTY",
      "expectedBatters": "FAIL_CLOSED_STATCAST_QUALITY_EXPECTED_BATTERS_EMPTY"
    },
    "perPitcherQualityRowMissingFallback": {
      "hardHitPct": 0,
      "barrelPct": 0,
      "note": "This fallback is part of the currently frozen production merge semantics and must be reproduced exactly if historical parity is claimed; it must not be silently redesigned during R1B1."
    }
  },
  "evaluatePitcherSemantics": {
    "missingPitcherDisposition": "NULL_SIGNAL",
    "minimumPa": 50,
    "fullConfidenceMinimumPa": 120,
    "partialConfidenceRange": "50_TO_119_PA_INCLUSIVE",
    "eraGap": "eraMinusXeraDiff",
    "xwobaGap": "xwobaMinusWobaDiff",
    "hardHitLeagueBaselinePct": 38,
    "rawFormula": "(-eraMinusXeraDiff * 0.30) + (xwobaMinusWobaDiff * 5.0) + (((hardHitPct - 38) / 100) * 0.8)",
    "cap": {
      "minimum": -0.45,
      "maximum": 0.45,
      "appliedBeforeRounding": true
    },
    "rounding": "ROUND_TO_0_01_AFTER_CAP",
    "displaySignalThresholds": {
      "regressionPendingAtOrAbove": 0.2,
      "underperformingAtOrBelow": -0.2,
      "otherwise": "ALIGNED_TEXT"
    },
    "returnedFields": [
      "pitcherId",
      "pitcherName",
      "era",
      "xera",
      "xwoba",
      "hardHitPct",
      "barrelPct",
      "runsDelta",
      "confidence",
      "signal"
    ]
  },
  "evaluateBatterSemantics": {
    "missingBatterDisposition": "NULL_CORRECTION",
    "minimumPa": 50,
    "luckDelta": "ROUND_TO_0_001(wOBA - xwOBA)",
    "overperformingAtOrAbove": 0.03,
    "underperformingAtOrBelow": -0.03,
    "otherwise": "REAL",
    "correctedWoba": "xwOBA",
    "currentV16ShortlistConsumption": "NOT_CONSUMED_DIRECTLY",
    "certifiedSnapshotRequirement": "EXPECTED_BATTER_SOURCE_MUST_STILL_BE_NONEMPTY_FOR_SNAPSHOT_CERTIFICATION"
  },
  "certifiedProviderSemantics": {
    "provider": "createMlbUnifiedV16CertifiedShortlistProvider",
    "requiresOfficialHomeAndAwayProbablePitcherIds": true,
    "missingPitcherIdentityDisposition": "SHORTLIST_EVIDENCE_UNAVAILABLE",
    "snapshotCall": "getStatcastQualityCertifiedSnapshot({ now: () => context.now })",
    "snapshotFailureDisposition": "SHORTLIST_EVIDENCE_UNAVAILABLE_FOR_ALL_ANALYSIS_ELIGIBLE_GAMES",
    "requiresSourceStatusCertified": true,
    "requiresProvenanceStatusCertified": true,
    "homeSP": "evaluatePitcher(snapshot.pitcherMap[homePitcherId])",
    "awaySP": "evaluatePitcher(snapshot.pitcherMap[awayPitcherId])",
    "fallbackToV62OrV66Allowed": false
  },
  "shortlistSemantics": {
    "component": "STATCAST_QUALITY",
    "certifiedPayloadRequired": true,
    "nativeSignals": [
      "homeSP.runsDelta",
      "awaySP.runsDelta"
    ],
    "zeroSignalIgnored": true,
    "signalSignInverted": false,
    "marketAgnostic": true,
    "predictsWinner": false,
    "recommendsBet": false,
    "requiresMarketOdds": false,
    "weightsApplied": false,
    "qualificationRule": "AT_LEAST_ONE_NONZERO_NATIVE_RUN_SIGNAL_FROM_CERTIFIED_COMPONENT",
    "rankingRole": "INDEPENDENT_COMPONENT_COUNT_THEN_MAX_NATIVE_RUN_MAGNITUDE_THEN_CERTIFIED_COVERAGE"
  },
  "existingHistoricalCustodyAssessment": {
    "v62": {
