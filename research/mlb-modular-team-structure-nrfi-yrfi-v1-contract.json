      "tieBreaker": "season_to_date_run_diff_per_game",
      "crossSection": "teams with at least 20 completed games before the game date",
      "STRONG": "top one-third of the pregame cross-sectional ranking",
      "MIDDLE": "middle one-third",
      "WEAK": "bottom one-third",
      "UNSTABLE": "selected team has fewer than 20 prior games"
    },
    "selectedTeamForTeamMarkets": "the model-selected side",
    "selectedTeamForNrfiYrfi": "NONE_GLOBAL_GAME_STATE",
    "teamTierMayNeverOverrideNegativeModelEdge": true
  },
