  "teamStrengthModule": {
    "principle": "Acceptance pressure is state-dependent, not team-name-dependent. A weak pregame team state must clear a stricter frontier than a strong pregame team state; early-season uncertainty receives the strictest treatment.",
    "pregameStandingsConstruction": {
      "source": "historical final outcomes reconstructed chronologically",
