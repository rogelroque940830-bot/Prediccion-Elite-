{
  "schemaVersion": "courtedge-p0-step12v80-capture-clock-operational-protocol.v1",
  "protocolRevision": 2,
  "effectiveOfficialDate": "2026-08-21",
  "scientificStatus": "FROZEN_V80_OPERATIONAL_CAPTURE_TIMING_REV2_BEFORE_2026_08_21_PREGAME_CAPTURES",
  "purpose": "Improve prospective capture completeness with one sanitized daily MLB slate snapshot, deterministic per-game T-10/T-7/T-4 clocks, and explicit delayed/postponed handling. Orchestration only; no model, threshold, route, ranking, staking, or outcome-embargo changes.",
  "parentHypothesisContract": "research/p0-step12v80-general-strength-prospective-confirmation-contract.json",
  "parentHypothesisContractModified": false,
  "dailySlate": {
    "fullSlateSnapshotAtOrAfterEasternTime": "10:30",
    "routineFullSlateReadsPerOfficialDate": 1,
    "snapshotSanitizedNoScores": true,
    "snapshotPath": "v80/slates/<officialDate>.json",
    "subsequentDispatchersUseFrozenSnapshot": true,
    "eachGameHandledByGamePk": true,
    "newGamesAddedAfterSnapshotAreNotSilentlyBackfilled": true
  },
  "captureClock": {
    "primaryAttempt": {
      "label": "T10",
      "leadMinutes": 10,
      "required": true
    },
    "conditionalRetries": [
      {
        "label": "T7",
        "leadMinutes": 7,
        "allowedOnlyWhen": "NO_CANONICAL_CAPTURE_WAS_CREATED_AT_T10"
      },
      {
        "label": "T4",
        "leadMinutes": 4,
        "allowedOnlyWhen": "NO_CANONICAL_CAPTURE_WAS_CREATED_AT_T10_OR_T7"
      }
    ],
    "stopImmediatelyAfterFirstValidCapture": true,
    "noFurtherAttemptAfterValidCapture": true,
    "noPostStartCapture": true,
    "noPostgameReconstruction": true,
    "stageLateToleranceMinutes": 0.75,
    "lateStageMustNotBeRelabeledAsEarlierStage": true,
    "captureCutoffEasternTime": "23:00"
  },
  "gameSpecificRevalidation": {
    "beforeEveryAttemptStage": true,
    "routineRevalidationScope": "TARGET_GAME_PK_ONLY",
    "latestOfficialStartTimeWins": true,
    "sameDayLaterStartRearmsClock": true,
    "delayedWithoutResolvedNewStartIsNonterminal": true,
    "postponedSameDateUnresolvedIsNonterminal": true,
    "postponedToAnotherDateIsTerminalForOriginalOfficialDate": true,
    "cancelledIsTerminal": true,
    "suspendedIsTerminal": true,
    "startedOrFinalIsTerminal": true,
    "nonterminalDelayRetryStatePersisted": true
  },
  "planner": {
    "dispatchCadenceMinutes": 10,
    "operatingWindowEasternTime": {
      "start": "10:30",
      "lastScheduledDispatcher": "22:50",
      "captureCutoff": "23:00"
    },
    "fullSlateRefetchedByRoutineDispatchers": false,
    "dispatchWindowLeadMinutes": {
      "exclusiveMinimum": 4,
      "inclusiveMaximum": 35
    },
    "activeDuplicateChildRunsSuppressedByGamePk": true,
    "reasonForDispatchBuffer": "A lightweight dispatcher reads the frozen 10:30 ET slate and wakes only gamePks approaching their clocks. Scientific timestamps still come from game-specific T10/T7/T4 revalidation, not dispatcher time."
  },
  "postponementPolicy": {
    "delayed": "HOLD_NONTERMINAL_AND_RETRY",
    "postponedSameDateUnresolved": "HOLD_NONTERMINAL_AND_RETRY",
    "postponedToAnotherDate": "TERMINAL_NO_CAPTURE_FOR_ORIGINAL_DATE",
    "cancelled": "TERMINAL_NO_CAPTURE",
    "suspended": "TERMINAL_NO_NEW_PREGAME_CAPTURE",
    "sameDayRescheduledLater": "FOLLOW_NEW_OFFICIAL_START_AND_REARM_T10",
    "after2300Eastern": "TERMINAL_NO_CAPTURE_FOR_THAT_DATE"
  },
  "exactIdentityRequirements": {
    "bothProbablePitchersRequired": true,
    "homeBattingOrderExactlyNineRequired": true,
    "awayBattingOrderExactlyNineRequired": true,
    "pregameStatusRequired": true
  },
  "parallelismAndCustody": {
    "differentGamesMayCaptureEvidenceInParallel": true,
    "sharedCanonicalMergeSerializedAfterEvidenceCapture": true,
    "firstCanonicalGameSnapshotImmutable": true,
    "duplicateGameCaptureReturnsExistingCanonicalSnapshot": true,
    "captureEvidenceTimestampComesFromPregameAttemptNotLaterMergeTime": true
  },
  "researchBoundary": {
    "researchOnly": true,
    "outcomesRead": false,
    "pricesRead": false,
    "oddsUsedAsFeatures": false,
    "sameDateCompletedGameOutcomesUsed": false,
    "modelChanged": false,
    "thresholdChanged": false,
    "rankingChanged": false,
    "routingChanged": false,
    "stakingChanged": false,
    "betEliteAllowed": false,
    "realFinancialExposure": 0
  }
}
