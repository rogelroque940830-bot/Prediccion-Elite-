# Court Edge backend — required before production deployment
NODE_ENV=production
PORT=5000

# Comma-separated frontend origins. Do not use * in production.
COURTEDGE_ALLOWED_ORIGINS=https://your-frontend.example

# Generate a long random value (32+ bytes). Used only for protected write operations.
COURTEDGE_WRITE_TOKEN=replace-with-a-random-secret

# External provider keys. Never commit real values.
ODDS_API_KEY=replace-in-Railway
BDL_API_KEY=replace-in-Railway

# Rate limits per IP and window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_READ_MAX=180
RATE_LIMIT_WRITE_MAX=30

# Legacy full-state sync stays disabled unless explicitly enabled for a controlled migration.
ALLOW_LEGACY_PICKS_SYNC=false

# Request body limits.
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=256kb
