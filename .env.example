# Court Edge backend — required before production deployment
NODE_ENV=production
PORT=5000

# Comma-separated exact frontend origins. Never use * in production.
COURTEDGE_ALLOWED_ORIGINS=https://your-frontend.example

# Browser-safe session authentication. Store these only in Railway.
COURTEDGE_SESSION_SECRET=replace-with-at-least-32-random-bytes
COURTEDGE_ADMIN_USERNAME=replace-with-private-admin-name
# Generate with:
# node scripts/generate-courtedge-password-hash.mjs 'your-long-password'
COURTEDGE_ADMIN_PASSWORD_SCRYPT=scrypt$replace-salt-hex$replace-hash-hex

# Optional machine-to-machine write token. Do not expose it through VITE_* or browser code.
COURTEDGE_WRITE_TOKEN=replace-with-a-random-service-secret

# External provider keys. Never commit real values.
ODDS_API_KEY=replace-in-Railway
BDL_API_KEY=replace-in-Railway

# Rate limits per IP and window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_READ_MAX=180
RATE_LIMIT_WRITE_MAX=30

# Legacy full-state sync stays disabled. It may only be enabled for a controlled migration.
ALLOW_LEGACY_PICKS_SYNC=false

# Request body limits.
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=256kb
